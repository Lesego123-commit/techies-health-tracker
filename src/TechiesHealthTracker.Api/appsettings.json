{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=techies_health_tracker;Username=postgres;Password=CHANGE_ME;SSL Mode=Prefer;Trust Server Certificate=true"
  },

  "Database": {
    "ApplyMigrationsOnStartup": true
  },

  "Firebase": {
    "ProjectId": "techies-health-tracker",
    "//ServiceAccountPath": "Path to a Firebase service account JSON file. Local development only.",
    "ServiceAccountPath": "",

    "//ServiceAccountJson": "The service account JSON itself. Supplied through Azure App Service configuration in production; never committed.",
    "ServiceAccountJson": "",
    "UseDevelopmentTokens": false,
    "DevelopmentSigningKey": ""
  },

  "Scheduling": {
    "TimeZoneId": "Africa/Johannesburg",
    "NextDoseSearchHorizonDays": 14,
    "MissedDoseGraceMinutes": 120
  },

  "ReminderScan": {
    "Enabled": true,
    "IntervalMinutes": 5
  },

  "BlobStorage": {
    "//": "Azure Blob Storage for uploaded documents (section 3.9). Left empty here on purpose: supplying the connection string switches the API from the local filesystem implementation to Blob Storage, and it holds the account key, so it is set as an App Service application setting and never committed.",
    "ConnectionString": "",
    "ContainerName": "documents"
  },

  "GeoApify": {
    "ApiKey": "",
    "BaseUrl": "https://api.geoapify.com/v2/",
    "Category": "healthcare.pharmacy",
    "MaxResults": 20,
    "CacheHours": 24,
    "TimeoutSeconds": 10
  },

  "FileStorage": {
    "RootPath": "App_Data/documents",
    "SigningKey": "",
    "PublicBaseUrl": ""
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
