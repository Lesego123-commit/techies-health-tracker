{
  "Database": {
    "ApplyMigrationsOnStartup": true
  },

  "Firebase": {
    "ProjectId": "techies-health-tracker",

    "//": "Development tokens let the API be run and exercised in Swagger without a live Firebase project. AuthenticationSetup refuses this flag outright in Production.",
    "UseDevelopmentTokens": true,
    "DevelopmentSigningKey": "techies-health-tracker-local-development-signing-key-2026"
  },

  "ReminderScan": {
    "//": "Off by default locally: the sweep writes notification rows every few minutes, which is noise while developing.",
    "Enabled": false,
    "IntervalMinutes": 5
  },

  "FileStorage": {
    "RootPath": "App_Data/documents",
    "SigningKey": "local-development-document-signing-key-change-in-production",
    "PublicBaseUrl": "https://localhost:7005"
  },

  "Cors": {
    "AllowedOrigins": [ "https://localhost:7005", "http://localhost:5192" ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
