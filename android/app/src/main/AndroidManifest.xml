<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        POE phase. Declared here as a reminder of what the remaining features need:
          - location for the pharmacy finder (Additional Feature 1)
          - notifications for the Firebase Cloud Messaging reminders (Requirement 6)
        Both are runtime permissions and must be requested in context, not on launch.
    -->
    <!--
        Coarse only, and deliberately so. The pharmacy search has a radius measured in kilometres,
        so a suburb-level fix gives the same list as a street-level one; asking for ACCESS_FINE
        would be requesting more about someone than the feature can use. Requested in context, on
        the pharmacy screen, rather than on launch.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Required from Android 13 to show notifications at all; requested at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TechiesApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TechiesHealthTracker"

        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TechiesHealthTracker"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Firebase delivers data messages here whether the app is in the foreground, the
            background, or not running at all, which is what makes a missed-dose alert arrive
            when the phone is locked in a pocket.
        -->
        <service
            android:name=".core.notifications.TechiesMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            Grants the camera app temporary access to one capture file at a time. exported=false
            plus grantUriPermissions means nothing can read these unless this app hands it a URI.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
